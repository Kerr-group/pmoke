{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "description": "Static bilingual documentation for the pmoke pulsed-MOKE CLI.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "build": "npm run build:wasm && next build && node scripts/evaluate-search.mjs && node scripts/postbuild.mjs && node scripts/generate-release-metadata.mjs",
    "build:site": "next build && node scripts/evaluate-search.mjs && node scripts/postbuild.mjs && node scripts/generate-release-metadata.mjs",
    "build:wasm": "wasm-pack build ../crates/pmoke-web-wasm --target web --out-dir ../../website/public/wasm --release --no-pack -- --locked",
    "dev": "pnpm build:wasm && next dev",
    "start": "node scripts/serve-basepath.mjs",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:ja": "node scripts/lint-ja.mjs",
    "lint:content": "node scripts/verify-content.mjs",
    "test:export": "node scripts/verify-export.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci collect --config=lighthouserc.cjs && node scripts/verify-lighthouse.mjs",
    "test:licenses": "node scripts/verify-licenses.mjs",
    "test:ai": "node scripts/verify-ai-resources.mjs",
    "test:search": "node scripts/evaluate-search.mjs",
    "test:signal": "node scripts/verify-signal.mjs",
    "check": "npm run lint && npm run lint:ja && npm run lint:content && npm run types:check && npm run test:search && npm run test:signal && npm run test:ai && npm run test:export"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.0",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.24",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
